# 阿里云 MCP 多账号配置
#
# ALIYUN_ACCOUNT_{账号标识}_{配置项}
#
# 必填: ACCOUNT_NAME
# 凭证二选一:
#   A) 直接写 ACCESS_KEY_ID / ACCESS_KEY_SECRET / DEFAULT_REGION
#   B) 写 CLI_PROFILE=本机 aliyun CLI 的 profile 名（从 ~/.aliyun/config.json 读 AK，仅支持 mode=AK）
# 可选: ROLE_ARN, ROLE_SESSION_NAME（若设置 ROLE_ARN，将用 STS AssumeRole 换取临时凭证）
# 可选全局: ALIYUN_CLI_CONFIG_PATH（默认 ~/.aliyun/config.json）
#

# 方式一：单账号，使用 CLI profile（无需在 .env 里写 AK）
# ALIYUN_ACCOUNT_GMI_INFRA_CLI_PROFILE=gmi-infra
# ALIYUN_ACCOUNT_GMI_INFRA_DEFAULT_REGION=cn-shanghai
# ALIYUN_ACCOUNT_GMI_INFRA_ACCOUNT_NAME=gmi infra账号

# 方式二：单账号，直接写 AK/SK（不推荐长期使用）
# ALIYUN_ACCOUNT_PRODUCTION_ACCESS_KEY_ID=YOUR_ALIYUN_ACCESS_KEY_ID
# ALIYUN_ACCOUNT_PRODUCTION_ACCESS_KEY_SECRET=YOUR_ALIYUN_ACCESS_KEY_SECRET
# ALIYUN_ACCOUNT_PRODUCTION_DEFAULT_REGION=cn-hangzhou
# ALIYUN_ACCOUNT_PRODUCTION_ACCOUNT_NAME=生产主账号

# 方式三：单账号，管理账号 AK/SK + STS AssumeRole 到目标账号
# ALIYUN_ACCOUNT_APP01_CLI_PROFILE=rd-manager
# ALIYUN_ACCOUNT_APP01_DEFAULT_REGION=cn-shanghai
# ALIYUN_ACCOUNT_APP01_ACCOUNT_NAME=应用项目账号01
# ALIYUN_ACCOUNT_APP01_ROLE_ARN=acs:ram::1234567890123456:role/ReadOnlyForMcp
# ALIYUN_ACCOUNT_APP01_ROLE_SESSION_NAME=aliyun-mcp

# 可选：CLI 配置文件路径（非默认位置时）
# ALIYUN_CLI_CONFIG_PATH=/path/to/config.json

# 可选：Landing Zone / Resource Directory 自动发现子账号
# 说明：先配置一个管理账号（如下方 rd_manager），再启用自动发现。
# ALIYUN_RD_AUTO_DISCOVERY=true
# ALIYUN_RD_MANAGER_ACCOUNT_KEY=rd_manager
# ALIYUN_RD_ROLE_NAME=ReadOnlyForMcp
# ALIYUN_RD_ROLE_SESSION_NAME=aliyun-mcp
# ALIYUN_RD_ACCOUNT_KEY_PREFIX=rd
# ALIYUN_RD_DEFAULT_REGION=cn-shanghai
# ALIYUN_RD_INCLUDE_SUSPENDED=false

# 示例：RD 管理账号（可用明文 AK 或 CLI profile）
# ALIYUN_ACCOUNT_RD_MANAGER_CLI_PROFILE=rd-manager
# ALIYUN_ACCOUNT_RD_MANAGER_DEFAULT_REGION=cn-shanghai
# ALIYUN_ACCOUNT_RD_MANAGER_ACCOUNT_NAME=资源目录管理账号
