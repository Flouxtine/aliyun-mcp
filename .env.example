# 阿里云 MCP 多账号配置
#
# ALIYUN_ACCOUNT_{账号标识}_{配置项}
#
# 必填: ACCOUNT_NAME
# 凭证二选一:
#   A) 直接写 ACCESS_KEY_ID / ACCESS_KEY_SECRET / DEFAULT_REGION
#   B) 写 CLI_PROFILE=本机 aliyun CLI 的 profile 名（从 ~/.aliyun/config.json 读 AK，仅支持 mode=AK）
# 可选: ROLE_ARN, ROLE_SESSION_NAME（若设置 ROLE_ARN，将用 STS AssumeRole 换取临时凭证）
# 可选全局: ALIYUN_CLI_CONFIG_PATH（默认 ~/.aliyun/config.json）
#

# 示例：使用 CLI profile「gmi-test」（无需在 .env 里写 AK）
ALIYUN_ACCOUNT_GMI_CLI_PROFILE=gmi-test
ALIYUN_ACCOUNT_GMI_ACCOUNT_NAME=gmi-test 环境

# 示例：生产（明文 AK）
ALIYUN_ACCOUNT_PRODUCTION_ACCESS_KEY_ID=LTAI5tXXXXXXXX
ALIYUN_ACCOUNT_PRODUCTION_ACCESS_KEY_SECRET=xxxxxxxxxxxxxxxx
ALIYUN_ACCOUNT_PRODUCTION_DEFAULT_REGION=cn-hangzhou
ALIYUN_ACCOUNT_PRODUCTION_ACCOUNT_NAME=生产主账号

# 示例：测试（明文 AK）
ALIYUN_ACCOUNT_STAGING_ACCESS_KEY_ID=LTAI5tYYYYYYYY
ALIYUN_ACCOUNT_STAGING_ACCESS_KEY_SECRET=yyyyyyyyyyyyyyyy
ALIYUN_ACCOUNT_STAGING_DEFAULT_REGION=cn-shanghai
ALIYUN_ACCOUNT_STAGING_ACCOUNT_NAME=测试账号

# 可选：CLI 配置文件路径（非默认位置时）
# ALIYUN_CLI_CONFIG_PATH=/path/to/config.json
